{
  "name": "graspit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "prisma migrate deploy && tsx scripts/start-production.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:import": "tsx scripts/import-json.ts",
    "db:verify-import": "tsx scripts/verify-import.ts",
    "db:backup-cleanup": "tsx scripts/backup-schema-cleanup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:admin": "tsx scripts/create-admin.ts",
    "uploads:migrate": "tsx scripts/migrate-images.ts",
    "uploads:cleanup": "tsx scripts/cleanup-uploads.ts",
    "verify:step2": "tsx scripts/verify-step2.ts",
    "verify:foundation": "tsx scripts/verify-foundation.ts",
    "verify:dev": "tsx scripts/verify-dev.ts",
    "verify:cleanup": "tsx scripts/verify-schema-cleanup.ts",
    "verify:profile": "tsx scripts/verify-profile.ts",
    "verify:analytics": "tsx --test scripts/verify-instructor-analytics.ts",
    "verify:loading": "tsx --test scripts/verify-loading.ts",
    "test": "npm run verify:step2 && npm run verify:foundation && npm run verify:cleanup && npm run verify:profile && npm run verify:analytics && npm run verify:loading && npm run verify:dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "busboy": "^1.6.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
