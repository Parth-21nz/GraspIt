# PostgreSQL connection string. Local example:
#   postgresql://graspit:graspit@localhost:5432/graspit
# Hosted (Neon/Supabase) URLs usually end in ?sslmode=require
DATABASE_URL="postgresql://graspit:graspit@localhost:5432/graspit"

# Secret used to derive session CSRF tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required outside development. Generate 32 random bytes; do not use this placeholder.
AUTH_SECRET=""

# "true" keeps the demo accounts (password: password123) and shows them on the
# sign-in page. Leave unset/false for anything with real users.
DEMO_MODE="false"

# Independent of demo accounts. "mock" grants simulated paid enrollments;
# "disabled" allows only free courses. Razorpay is a future milestone.
PAYMENTS_MODE="disabled"

# Exact browser origin. Use HTTPS on a public deployment.
PUBLIC_ORIGIN="http://localhost:3000"
# Direct connections by default. For a proxy, list only its trusted IPs/subnets.
TRUST_PROXY="false"

# Absolute cookie-session lifetime. HTTPS origins always use Secure cookies;
# HTTP cookies are only permitted for the explicit localhost origin.
SESSION_DAYS="7"
# Local email never leaves your computer. Read with npm run mail:outbox.
# Outbox mode requires a localhost origin. Public demos may use disabled.
MAIL_MODE="outbox"
MAIL_OUTBOX_DIR=".data/mail-outbox"

# Local storage works without keys. Use Cloudinary for persistent hosted uploads.
IMAGE_STORAGE="local"
UPLOAD_DIR=".data/uploads"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="graspit"

# Optional additional direct-media hosts; replace this list explicitly.
# VIDEO_ORIGINS="https://www.youtube.com,https://youtube.com,https://youtu.be,https://www.youtube-nocookie.com,https://vimeo.com,https://player.vimeo.com"

# Optional direct URL for migrations when DATABASE_URL uses a connection pooler.
# DIRECT_URL="postgresql://..."

# Only used by `npm run db:import` to locate the old JSON database file.
# DATA_DIR=".data"

# Set automatically by most hosts.
# PORT=3000
