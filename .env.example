# Secret used to sign login tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# "true" keeps the demo accounts (password: password123) and shows them on the
# sign-in page. Leave unset/false for anything with real users.
DEMO_MODE="false"

# Optional: where the JSON database is stored (point at a persistent disk).
# DATA_DIR="/var/data"

# Set automatically by most hosts.
# PORT=3000
